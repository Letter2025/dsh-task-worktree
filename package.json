{
  "name": "dsh-task-worktree",
  "version": "0.1.3",
  "description": "Complete Git worktree support for DeepSeek Harness: task-scoped isolated worktrees with per-repo manifests, workspace registration, bring-back to main, direct commit, and durable state. Reference: Qoder / Codex / Claude Code worktrees.",
  "author": "Letter2025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Letter2025/dsh-task-worktree.git"
  },
  "bugs": {
    "url": "https://github.com/Letter2025/dsh-task-worktree/issues"
  },
  "homepage": "https://github.com/Letter2025/dsh-task-worktree",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "worktree",
    "git",
    "parallel-development",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-subprocess": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7"
  },
  "scripts": {
    "test": "node test/smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=20"
  }
}