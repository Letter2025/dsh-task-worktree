{
  "name": "dsh-task-worktree",
  "version": "0.4.2",
  "description": "Complete Git worktree support for DeepSeek Harness: task-scoped isolated worktrees with per-repo manifests, workspace registration, bring-back to main, direct commit, and durable state. Reference: Qoder / Codex / Claude Code worktrees.",
  "author": "Letter2025",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Letter2025/dsh-task-worktree.git"
  },
  "bugs": {
    "url": "https://github.com/Letter2025/dsh-task-worktree/issues"
  },
  "homepage": "https://github.com/Letter2025/dsh-task-worktree",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "worktree",
    "git",
    "parallel-development",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./client/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "scripts": {
    "build:client": "tsdown && node scripts/normalize-sourcemap.mjs",
    "typecheck": "tsc -p tsconfig.client.json --noEmit",
    "test": "node test/smoke.mjs",
    "release:check": "node scripts/publish.mjs --dry-run",
    "release": "node scripts/publish.mjs",
    "prepublishOnly": "npm test && npm run build:client"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.2-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.2-rc.1",
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.2-rc.1",
    "@types/react": "~18.3.1",
    "lightningcss": "^1.25.0",
    "react": "^18.2.0",
    "tsdown": "^0.17.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}